OPENAI_API_KEY=your_openai_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key
GOOGLE_API_KEY=your_google_api_key
OLLAMA_BASE_URL=your_ollama_url
OPENROUTER_BASE_URL=your_openrouter_url
OPENROUTER_API_KEY=your_openrouter_api_key

# 暗网搜索配置
ENABLE_DARKWEB=true
TOR_PROXY_PORT=9150

# Breached论坛认证（可选）
# 注册账号后在此配置用户名和密码
# BREACHED_USERNAME=your_username
# BREACHED_PASSWORD=your_password

# 自定义暗网站点（JSON格式，可添加多个）
# CUSTOM_ONION_SITES=[{"name":"SiteName","url":"http://xxx.onion","auth":{"type":"basic","username":"user","password":"pass"}}]