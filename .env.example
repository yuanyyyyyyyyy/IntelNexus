# =============================================
# IntelNexus 环境配置模板
# =============================================
# 复制此文件为 .env 并填入你的配置:
# cp .env.example .env

# ========== LLM配置 ==========
# 本地Ollama (推荐，免费且保护隐私)
OLLAMA_BASE_URL=http://127.0.0.1:11434

# OpenAI GPT模型
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic Claude模型
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google Gemini模型
GOOGLE_API_KEY=your_google_api_key_here

# OpenRouter (免费模型: https://openrouter.ai)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ========== 搜索配置 ==========
# 新闻API (可选)
NEWS_API_KEY=your_newsapi_key_here

# ========== 功能开关 ==========
# 暗网搜索 (需要Tor网络)
ENABLE_DARKWEB=false

# Tor代理端口 (默认9150)
TOR_PROXY_PORT=9150

# ========== 自定义暗网站点 (JSON格式，可选) ==========
# CUSTOM_ONION_SITES=[{"name":"SiteName","url":"http://xxx.onion","auth":{"type":"basic","username":"user","password":"pass"}}]

# ========== 可信度评估与知识图谱 ==========
ENABLE_CREDIBILITY=true