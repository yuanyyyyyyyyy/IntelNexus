# IntelNexus 环境变量配置
# 复制此文件为 .env 并填入实际值

# ========== LLM 配置 ==========
# 至少配置一个 LLM 提供商
OLLAMA_BASE_URL=http://127.0.0.1:11434
# OPENAI_API_KEY=sk-xxx
# ANTHROPIC_API_KEY=sk-ant-xxx
# GOOGLE_API_KEY=xxx
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_API_KEY=sk-or-xxx

# ========== 搜索配置 ==========
# NEWS_API_KEY=xxx
# SEMANTIC_SCHOLAR_API_KEY=xxx
# TWITTER_BEARER_TOKEN=xxx

# ========== 功能开关 ==========
ENABLE_DARKWEB=false
# Tor 代理 SOCKS 端口：9150 = Tor 浏览器默认；若使用独立 Tor 守护进程则为 9050，按需修改
TOR_PROXY_PORT=9150
ENABLE_CREDIBILITY=true

# ========== SMTP 邮件推送 ==========
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your@email.com
# SMTP_PASSWORD=your-password
# SMTP_USE_TLS=true

# ========== 简报品牌落款（可配置，不写死任何品牌） ==========
# 留空则对应信息在简报中省略
# ORGANIZATION_NAME=你的机构名
# ORGANIZATION_PRODUCER_UNIT=你的出品单位
# ORGANIZATION_CONTACT=联系人：张三 / 微信：xxx
# ORGANIZATION_FOOTER_QR_TEXT=获取更多安全情报
# ORGANIZATION_DISCLAIMER=本简报基于公开信息整理，不构成投资或其他专业建议。
