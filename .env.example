# IntelNexus 环境变量配置
# 复制此文件为 .env 并填入实际值

# ========== LLM 配置 ==========
# 至少配置一个 LLM 提供商
OLLAMA_BASE_URL=http://127.0.0.1:11434
# OPENAI_API_KEY=sk-xxx
# ANTHROPIC_API_KEY=sk-ant-xxx
# GOOGLE_API_KEY=xxx
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_API_KEY=sk-or-xxx

# ========== 搜索配置 ==========
# NEWS_API_KEY=xxx
# SEMANTIC_SCHOLAR_API_KEY=xxx
# TWITTER_BEARER_TOKEN=xxx

# ========== 功能开关 ==========
ENABLE_DARKWEB=false
# Tor 代理 SOCKS 端口：9150 = Tor 浏览器默认；若使用独立 Tor 守护进程则为 9050，按需修改
TOR_PROXY_PORT=9150
ENABLE_CREDIBILITY=true

# ========== SMTP 邮件推送 ==========
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your@email.com
# SMTP_PASSWORD=your-password
# SMTP_USE_TLS=true

# ========== 简报品牌落款（可配置，不写死任何品牌） ==========
# 留空则对应信息在简报中省略
# ORGANIZATION_NAME=你的机构名
# ORGANIZATION_PRODUCER_UNIT=你的出品单位
# ORGANIZATION_CONTACT=联系人：张三 / 微信：xxx
# ORGANIZATION_FOOTER_QR_TEXT=获取更多安全情报
# ORGANIZATION_DISCLAIMER=本简报基于公开信息整理，不构成投资或其他专业建议。

# ========== 订阅者关注点（interests）配置 ==========
# 关注点用于「按订阅者个性化简报推送」：仅向其发送感兴趣板块，其余折叠为「已省略」，实现降噪。
# 注意：interests 不写在 .env 里，而是配置在 data/subscriptions.json 的订阅者记录中，
#       字段名为 interests（与 categories 等价，代码中二选一即可）。
# 取值为情报 topic id，有效值如下：
#   AI 领域动态：ai_gov_usage, ai_china_narrative, ai_legislation, ai_data_leak
#   网络安全动态：cyber_vuln, cyber_attack
# （留空或缺失 interests 表示接收全部板块）
#
# data/subscriptions.json 示例结构：
# {
#   "subscribers": [
#     {
#       "id": "sub_20260807235959",
#       "name": "张三",
#       "email": "zhangsan@example.com",
#       "channels": { "email": { "enabled": true, "address": "zhangsan@example.com" } },
#       "schedule": { "enabled": true, "cron": "0 9 * * *" },
#       "interests": ["ai_gov_usage", "cyber_vuln"],
#       "created_at": "2026-08-07T23:59:59.000000",
#       "last_sent": null
#     }
#   ]
# }
# 也可通过界面「订阅管理」添加订阅者并勾选关注点，无需手工编辑 JSON。
