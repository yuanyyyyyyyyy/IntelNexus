# IntelNexus 容器环境变量模板
# 用法：复制为 .env 并填入真实值（.env 已被 .gitignore 与 .dockerignore 排除，不会入库/入镜像）
#   cp .env.example .env
# docker-compose 通过 env_file 注入这些变量到容器。

# ========== LLM 模型（定时简报必填其一，否则走降级模板文案） ==========
# OpenRouter：在 UI「模型设置」添加对应自定义模型，或在此兜底
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Google AI (Gemini) 兜底密钥
GOOGLE_API_KEY=
# 本地 Ollama 地址（容器内默认无 Ollama，留空即不使用本地模型）
OLLAMA_BASE_URL=http://127.0.0.1:11434

# ========== 数据目录（容器内固定，挂载 volume 即持久化） ==========
INTELNEXUS_DATA_DIR=/app/data

# ========== 搜索源开关（可选，按需开启） ==========
ENABLE_DARKWEB=false
ENABLE_OTX=false
ENABLE_CISA_KEV=false
ENABLE_CNVD=false
ENABLE_ARXIV=false
ENABLE_HUGGINGFACE=false
# 漏洞情报源（默认关闭，可在 UI「搜索服务设置」开启；NVD 无 API key 时限速 6s/请求）
ENABLE_NVD=false
ENABLE_EXPLOITDB=false
# 小红书：经「站内检索后端」按站内限定语义检索（不直连小红书接口、不绕过反爬）。
# 实测公共网页引擎均不可用（cn.bing.com 与 bing.com?format=rss 忽略 site: 算子、
# baidu 触发安全验证、DDG 返回 HTTP 202），故需先配置下方站内检索后端再开启本源。
ENABLE_XIAOHONGSHU=false

# ========== 站内检索后端（小红书等站内源取数依赖） ==========
# provider: auto（按 博查 > Brave > Google CSE 择一）| bocha | brave | google_cse
SITE_SEARCH_PROVIDER=auto
# 博查 Web Search API（推荐）：国内可直连、无需代理；充值制（HTTP 403 = 余额不足）
#   申请：open.bochaai.com -> 控制台 -> API KEY 管理
BOCHA_API_KEY=
# Brave Web Search API：只需 1 个订阅令牌
#   申请：api.search.brave.com（2026 起条款有变，请自行核实额度与是否需绑卡）
BRAVE_API_KEY=
# Google Custom Search JSON API：官方已「不再向新客户开放」，仅存量 Key 可用
#   （存量客户须在 2027-01-01 前迁移）；保留该 Provider 仅为兼容已有 Key
#   申请（存量）：programmablesearchengine.google.com 建站得 CX；
#                 Google Cloud 启用 Custom Search JSON API 得 API Key
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=

# ========== SMTP 邮件（可选） ==========
# 注：UI 模式优先使用 data/email_settings.json（界面配置并持久化）。
# 此处为 CLI 模式兜底，也可与界面配置并存（.env 密码优先于界面保存的密码）。
SMTP_SERVER=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# ========== 切勿设置以下项（会让数据落入临时目录，容器重建即丢） =========
# STREAMLIT_SHARING=true
