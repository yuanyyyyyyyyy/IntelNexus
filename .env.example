# IntelNexus 环境变量模板
# 复制本文件为 .env 并按需填写。全部可留空——应用无任何必填项。

# ---- LLM API Keys（也可运行后在界面侧边栏「模型管理」中添加）----
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_BASE_URL=
OPENROUTER_API_KEY=

# 本地 Ollama 地址（默认 http://127.0.0.1:11434，通常无需修改）
OLLAMA_BASE_URL=

# ---- 数据源 API（可选增强）----
SEMANTIC_SCHOLAR_API_KEY=
NEWS_API_KEY=
TWITTER_BEARER_TOKEN=

# ---- 暗网源（默认关闭）----
ENABLE_DARKWEB=false
TOR_PROXY_PORT=9150
BREACHED_USERNAME=
BREACHED_PASSWORD=

# ---- 邮件推送（推荐配置方式）----
# 安全提示：SMTP 密码等敏感凭据应在此文件中配置，而非 data/email_settings.json。
# .env 已在 .gitignore 中，不会被提交到 Git；而 data/ 目录存在意外打包/提交风险。
# UI「邮件设置」中保存的值会覆盖此处配置（密码字段除外，此处优先）。
SMTP_SERVER=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
# SMTP_FROM_NAME=AI简报系统  # 可选：发件人显示名称

# ---- 网络代理（境外数据源需要；留空则直连）----
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
NO_PROXY=localhost,127.0.0.1

# ---- 可选：语义评分增强（默认禁用，见 requirements-extras.txt）----
# DISABLE_SENTENCE_TRANSFORMER=true

# ---- 功能开关（可选，以下为默认值，取消注释即可覆盖）----
# ENABLE_CREDIBILITY=true        # 可信度评估与知识图谱
# ENABLE_VISUALIZATION=true      # 搜索结果图表可视化
# ENABLE_HN=true                 # Hacker News 源
# ENABLE_DARKWEB=false           # 暗网搜索（需 Tor 或 Ahmia）
# USE_TOR=false                  # 强制所有请求走 Tor 代理
# ENABLE_OTX=false               # AlienVault OTX 威胁情报
# ENABLE_EXPLOITDB=false         # ExploitDB 漏洞利用库
# ENABLE_NVD=false               # NVD 国家漏洞数据库
# ENABLE_CISA_KEV=false          # CISA 已知被利用漏洞
# ENABLE_CNVD=false              # CNVD 国家信息安全漏洞共享平台
# ENABLE_ARXIV=false             # arXiv 学术论文
# ENABLE_HUGGINGFACE=false       # HuggingFace 模型库
