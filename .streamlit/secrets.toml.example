# IntelNexus Streamlit Community Cloud Secrets 模板
# ================================================
# 在 Streamlit Cloud 部署时，将以下内容填入 Settings → Secrets
# 格式为 TOML，每个 key 占一行。
#
# 所有项均为可选——不填则走 UI 侧边栏手动配置。
# 注意：SCC 上无法运行 Ollama 本地模型，请使用云端 API。

# ---- 云端 LLM API Keys（推荐至少填一个）----
# OPENROUTER_API_KEY = "sk-or-xxxx"
# GOOGLE_API_KEY = "AIzaSy-xxxx"
# OPENAI_API_KEY = "sk-xxxx"

# ---- 搜索 API（可选增强）----
# NEWS_API_KEY = "your-newsapi-key"

# ---- 邮件推送（可选，配置后可在 UI 中推送简报）----
# SMTP_SERVER = "smtp.gmail.com"
# SMTP_PORT = 587
# SMTP_USERNAME = "your@gmail.com"
# SMTP_PASSWORD = "your-app-password"
# SMTP_USE_TLS = true
