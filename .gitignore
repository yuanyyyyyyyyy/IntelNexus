coverage_result.txt
tcounts.txt
*.pdf
*.docx
*.xlsx

# Test files（test_*.py 为全局忽略，tests/ 目录经下方例外重新纳入）
test_*.py
!tests/test_*.py

# Streamlit
.streamlit/secrets.toml

# Temporary & backup files
*.tmp
*.bak
*.bak2
# Office 锁文件（Word/Excel 打开文档时生成的 ~$xxx 临时文件）
~$*

